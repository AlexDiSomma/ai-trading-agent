# Copiare in .env.local. Qui NON vanno mai credenziali del broker:
# il frontend parla solo con il backend.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Deve coincidere con API_AUTH_TOKEN del backend.
API_TOKEN=

# Login della dashboard: NON compilare a mano, usare `npm run imposta-password`
# (scrive utente, impronta scrypt della password e segreto della sessione).
DASHBOARD_USER=
DASHBOARD_PASSWORD_HASH=
SESSION_SECRET=
