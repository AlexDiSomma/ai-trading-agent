# ============================================================
#  AI TRADING AGENT - configurazione
#  Copiare in .env e compilare SOLO sul proprio PC.
#  .env e' escluso da git: nessun segreto entra nel repository.
# ============================================================

# ------------------------------------------------------------
# MODALITA' OPERATIVA
# OBSERVE = solo analisi, nessun piano operativo
# SIGNAL  = genera TradePlan ma non esegue
# PAPER   = simula l'esecuzione (default)
# LIVE    = esegue realmente (richiede anche ENABLE_LIVE_TRADING=true)
# ------------------------------------------------------------
APP_MODE=PAPER
APP_ENABLE_LIVE_TRADING=false
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=UTC

# Kill switch: se il file esiste, nessun ordine puo' partire.
# Sta fuori dal processo per poter essere azionato anche con l'API giu'.
APP_KILL_SWITCH_FILE=var/KILL_SWITCH
APP_KILL_SWITCH_ENABLED=false

# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------
LOG_LEVEL=INFO
# console oppure json
LOG_FORMAT=console
LOG_FILE=logs/backend.log

# ------------------------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_agent
DB_USER=trading
DB_PASSWORD=cambiami
DB_POOL_SIZE=10
# Attesa massima per aprire una connessione: tiene veloce il controllo di stato
# quando il database e' spento.
DB_CONNECT_TIMEOUT_SECONDS=5
DB_ECHO=false

# ------------------------------------------------------------
# REDIS (cache contesti + code dei worker)
# ------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT_SECONDS=1.5

# ------------------------------------------------------------
# METATRADER 5 / XM
# Il terminale MT5 deve essere installato, aperto e loggato.
# MetaTrader5 (il pacchetto Python) gira SOLO su Windows:
# vedi docs/adr/0003-mt5-gateway-windows.md
# ------------------------------------------------------------
MT5_ENABLED=true
# true = terminale finto (utile senza Windows o senza MT5 aperto)
MT5_USE_MOCK=false
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=XMGlobalMU-MT5 2
MT5_TERMINAL_PATH=C:\Program Files\XM Global MU MT5 Terminal\terminal64.exe
MT5_TIMEOUT_MS=10000
MT5_PORTABLE=false
# Secondi oltre i quali un tick e' considerato "stale" -> fail closed
MT5_MAX_TICK_AGE_SECONDS=15

# ------------------------------------------------------------
# AI PROVIDER (astratto: anthropic | openai | null)
# null = nessuna AI; con AI_REQUIRED=true il sistema non opera.
# ------------------------------------------------------------
AI_PROVIDER=anthropic
AI_REQUIRED=true
AI_MODEL=claude-opus-5
AI_TEMPERATURE=0.0
AI_MAX_OUTPUT_TOKENS=4000
AI_TIMEOUT_SECONDS=90
AI_DAILY_COST_LIMIT_USD=10
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# ------------------------------------------------------------
# LIMITI DI RISCHIO - LI DEFINISCE L'UTENTE, L'AI NON LI TOCCA
# Le percentuali sono sull'equity; gli importi in valuta del conto.
# ------------------------------------------------------------
RISK_ACCOUNT_CURRENCY=EUR
RISK_RISK_BUDGET=1000
RISK_DAILY_MAX_LOSS_PCT=2.0
RISK_WEEKLY_MAX_LOSS_PCT=5.0
RISK_MAX_DRAWDOWN_PCT=10.0
RISK_MAX_RISK_PER_TRADE_PCT=0.5
RISK_MAX_OPEN_RISK_PCT=1.5
RISK_MAX_OPEN_POSITIONS=3
RISK_MAX_POSITION_SIZE_LOTS=0.5
RISK_MAX_LEVERAGE=30
RISK_MINIMUM_RR=1.8
# Spread massimo come frazione dell'ATR del timeframe di esecuzione:
# e' il controllo primario, l'unico confrontabile fra strumenti con
# scale di prezzo diverse (35 punti sono 3,5 pip su EURUSD e nulla su
# US100Cash, dove lo spread normale e' 616 punti).
RISK_MAX_SPREAD_ATR_RATIO=0.30
# Tetto assoluto di sicurezza, usato solo quando l'ATR non e' calcolabile.
RISK_MAX_SPREAD_POINTS=1000
RISK_MAX_SLIPPAGE_POINTS=20
RISK_MAX_CORRELATED_EXPOSURE_PCT=1.0
RISK_MIN_STOP_DISTANCE_ATR=0.5
RISK_MAX_STOP_DISTANCE_ATR=3.0
RISK_MIN_CONFIDENCE=0.65
# Whitelist strumenti: nulla fuori da qui viene mai toccato.
# ATTENZIONE: usare la grafia ESATTA del broker. Su XM l'oro si chiama
# GOLD (non XAUUSD) e gli indici US30Cash / US100Cash / US500Cash.
# L'elenco completo dei nomi: GET /api/market/symbols-available
RISK_ALLOWED_SYMBOLS=EURUSD,GBPUSD,USDJPY,EURJPY,GBPJPY,GOLD,SILVER,US30Cash,US100Cash,US500Cash
# Sessioni autorizzate (ora del server broker), formato HH:MM-HH:MM
RISK_ALLOWED_SESSIONS=08:00-17:30
RISK_ALLOWED_WEEKDAYS=0,1,2,3,4
# Filtro eventi macro ad alto impatto (minuti)
RISK_BLOCK_HIGH_IMPACT_BEFORE_MINUTES=60
RISK_BLOCK_HIGH_IMPACT_AFTER_MINUTES=30

# ------------------------------------------------------------
# API / FRONTEND
# ------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
# Token per le chiamate del frontend (generane uno lungo e casuale)
API_AUTH_TOKEN=
